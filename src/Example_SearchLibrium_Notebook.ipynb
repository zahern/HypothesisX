[{"cell_type": "markdown", "id": "cell-0", "metadata": {}, "source": ["# SearchLibrium 0.0.109 - Complete Model Testing\n", "\n", "This notebook comprehensively tests the SearchLibrium MixedLogit model\n", "using the Zeke MXL configuration with Berlin data and compares results to searchlogit."]}, {"cell_type": "markdown", "id": "cell-1", "metadata": {}, "source": ["## Step 1: Version Check and Imports"]}, {"cell_type": "code", "execution_count": null, "id": "cell-2", "metadata": {}, "outputs": [], "source": ["import subprocess\n", "import sys\n", "import numpy as np\n", "import pandas as pd\n", "from SearchLibrium.MixedLogit import MixedLogit\n", "from SearchLibrium.Halton import Draws\n", "\n", "print(\"SearchLibrium version check:\")\n", "import SearchLibrium\n", "print(f\"Current version: {SearchLibrium.__version__}\")\n", "print(f\"Expected version: 0.0.109\")\n", "print(f\"Match: {SearchLibrium.__version__ == '0.0.109'}\")\n", "print(\"\\n[OK] All imports successful\"]}, {"cell_type": "markdown", "id": "cell-3", "metadata": {}, "source": ["## Step 2: Verify Configuration"]}, {"cell_type": "code", "execution_count": null, "id": "cell-2b", "metadata": {}, "outputs": [], "source": ["# Quick check that Sobol is the default\n", "draws_test = Draws(k=3, halton_opts=None)\n", "print(f\"Sobol is default: {draws_test.halton.use_sobol}\")\n", "\n", "# Check JAX is available\n", "try:\n", "    import jax\n", "    print(f\"JAX is available: True\")\n", "    print(f\"JAX version: {jax.__version__}\")\nexcept ImportError:\n", "    print(f\"JAX is available: False\")"]}, {"cell_type": "markdown", "id": "cell-4", "metadata": {}, "source": ["## Step 3: Load and Prepare Data"]}, {"cell_type": "code", "execution_count": null, "id": "cell-3", "metadata": {}, "outputs": [], "source": ["# Load Berlin data (Zeke MXL dataset)\n", "data_path = 'C:/Users/ahernz/source/SearchLibrium/data/Berlin_Data.csv'\n", "\n", "try:\n", "    df = pd.read_csv(data_path)\n", "    print(f\"[OK] Data loaded: {df.shape[0]} rows, {df.shape[1]} columns\")\n", "except FileNotFoundError:\n", "    print(f\"[ERROR] Data not found at {data_path}\")\n", "    raise\n", "\n", "# Negate price (utility model convention)\n", "df['PRICE'] = df['PRICE'] * -1\n", "\n", "# Variable names (16 total)\n", "varnames = [\n", "    'RECRE', 'PRICE', 'CF', 'CF_car', 'CF_stay', 'CF_pt', \n", "    'CF_age', 'CF_male', 'BIKELANE', 'BIKESEP', 'DIST6', 'DIST3',\n", "    'FREQ_HIGHER', 'FREQ_HIGHEST', 'UNGUARDED', 'GUARDED'\n", "]\n", "\n", "# Random variables (10 total: 1 lognormal, 9 normal)\n", "randvars = {\n", "    'RECRE': 'n',           # Normal\n", "    'PRICE': 'ln',          # Lognormal\n", "    'BIKELANE': 'n',        # Normal\n", "    'BIKESEP': 'n',         # Normal\n", "    'DIST6': 'n',           # Normal\n", "    'DIST3': 'n',           # Normal\n", "    'FREQ_HIGHER': 'n',     # Normal\n", "    'FREQ_HIGHEST': 'n',    # Normal\n", "    'UNGUARDED': 'n',       # Normal\n", "    'GUARDED': 'n'          # Normal\n", "}\n", "\n", "print(f\"\\nVariables configured:\")\n", "print(f\"  Total variables: {len(varnames)}\")\n", "print(f\"  Random variables: {len(randvars)} (1 lognormal, 9 normal)\")\n", "print(f\"  Respondents: {df['ID_1'].nunique()}\")\n", "print(f\"  Total observations: {len(df)}\")\n", "print(f\"  Alternatives: {df['Scenario'].nunique()}\")\n", "print(f\"  Choices per respondent: {df.groupby('ID_1').size().mean():.1f}\")"]}, {"cell_type": "markdown", "id": "cell-5", "metadata": {}, "source": ["## Step 4: Setup Model with Optimal Configuration"]}, {"cell_type": "code", "execution_count": null, "id": "cell-4", "metadata": {}, "outputs": [], "source": ["# Extract data columns\n", "choice_id = df['csn']\n", "ind_id = df['ID_1']\n", "choice_var = df['Choice_']\n", "alt_var = df['Scenario']\n", "\n", "# Create model instance\n", "model = MixedLogit()\n", "\n", "# Setup with OPTIMAL configuration for searchlogit matching\n", "print(\"Setting up MixedLogit model with optimal configuration...\")\n", "print(f\"  Method: SLSQP\")\n", "print(f\"  ftol: 1e-12 (tight convergence)\")\n", "print(f\"  gtol: 1e-6\")\n", "print(f\"  maxiter: 1000\")\n", "print(f\"  n_draws: 200 (Sobol sequences)\")\n", "print(f\"  JAX: Enabled (automatic differentiation)\")\n", "\n", "model.setup(\n", "    X=df[varnames],\n", "    y=choice_var,\n", "    varnames=varnames,\n", "    ids=choice_id,\n", "    panels=ind_id,\n", "    alts=alt_var,\n", "    base_alt=None,\n", "    fit_intercept=False,\n", "    n_draws=200,\n", "    randvars=randvars,\n", "    method='slsqp',         # SLSQP is optimal for this problem\n", "    gtol=1e-6,\n", "    ftol=1e-12,             # Tight tolerance for better convergence\n", "    maxiter=1000,\n", "    mnl_init=True           # Initialize with MNL\n", ")\n", "\n", "print(\"\\n[OK] Model setup complete\")\n", "print(f\"\\nModel dimensions:\")\n", "print(f\"  N (respondents): {model.N}\")\n", "print(f\"  P (choices/respondent): {model.P}\")\n", "print(f\"  J (alternatives): {model.J}\")\n", "print(f\"  K (variables): {model.K}\")\n", "print(f\"  Kf (fixed parameters): {model.Kf}\")\n", "print(f\"  Kr (random parameters): {model.Kr}\")\n", "print(f\"\\nConfiguration:\")\n", "print(f\"  Method: {model.method}\")\n", "print(f\"  ftol: {model.ftol}\")\n", "print(f\"  JAX enabled: {getattr(model, '_jax', False)}\")\n", "print(f\"  Sobol sequences: {model.draws_generator.halton.use_sobol}\")"]}, {"cell_type": "markdown", "id": "cell-6", "metadata": {}, "source": ["## Step 5: Run Multiple Fits to Show Consistency"]}, {"cell_type": "code", "execution_count": null, "id": "cell-5", "metadata": {}, "outputs": [], "source": ["print(\"\\n\" + \"=\"*80)\n", "print(\"RUNNING 5 CONSECUTIVE FITS TO TEST CONVERGENCE\")\n", "print(\"=\"*80)\n", "\n", "results = []\n", "run_details = []\n", "\n", "for run in range(1, 6):\n", "    print(f\"\\n[Run {run}/5] Fitting model...\")\n", "    \n", "    # Create fresh model for each run\n", "    model_run = MixedLogit()\n", "    model_run.setup(\n", "        X=df[varnames],\n", "        y=choice_var,\n", "        varnames=varnames,\n", "        ids=choice_id,\n", "        panels=ind_id,\n", "        alts=alt_var,\n", "        base_alt=None,\n", "        fit_intercept=False,\n", "        n_draws=200,\n", "        randvars=randvars,\n", "        method='slsqp',\n", "        gtol=1e-6,\n", "        ftol=1e-12,\n", "        maxiter=1000,\n", "        mnl_init=True\n", "    )\n", "    \n", "    # Fit the model\n", "    model_run.fit()\n", "    \n", "    # Compute metrics\n", "    ll = model_run.loglik\n", "    gap = abs(ll - (-1970.355))\n", "    results.append((run, ll, gap))\n", "    \n", "    # Print result\n", "    print(f\"  LL: {ll:15.6f}  |  Gap: {gap:8.3f}  |  Converged: {model_run.converged}\")\n", "    run_details.append({\n", "        'run': run,\n", "        'll': ll,\n", "        'gap': gap,\n", "        'converged': model_run.converged,\n", "        'iterations': model_run.n_iter\n", "    })\n", "\n", "# Compute statistics\n", "lis = [r[1] for r in results]\n", "gaps = [r[2] for r in results]\n", "\n", "best = min(results, key=lambda x: x[2])\n", "worst = max(results, key=lambda x: x[2])\n", "avg_ll = np.mean(lis)\n", "avg_gap = np.mean(gaps)\n", "std_gap = np.std(gaps)\n", "\n", "print(\"\\n\" + \"=\"*80)\n", "print(\"RESULTS SUMMARY\")\n", "print(\"=\"*80)\n", "print(f\"\\nBest:       Run {best[0]}, LL = {best[1]:15.6f}, Gap = {best[2]:8.3f} points\")\n", "print(f\"Worst:      Run {worst[0]}, LL = {worst[1]:15.6f}, Gap = {worst[2]:8.3f} points\")\n", "print(f\"Average:    LL = {avg_ll:15.6f}, Gap = {avg_gap:8.3f} points\")\n", "print(f\"Std Dev:    {std_gap:8.3f} points\")\n", "print(f\"\\nTarget (searchlogit): -1970.355\")\n", "print(f\"Reference improvement: {2050 + avg_ll:.1f} points from initial +2050\")\n", "print(f\"Improvement percentage: {(2050 + avg_ll) / 2050 * 100:.2f}%\")\n", "print(\"=\"*80)"]}, {"cell_type": "markdown", "id": "cell-7", "metadata": {}, "source": ["## Step 6: Single High-Quality Fit"]}, {"cell_type": "code", "execution_count": null, "id": "cell-6", "metadata": {}, "outputs": [], "source": ["print(\"\\nPerforming final high-quality fit with optimal settings...\\n\")\n", "\n", "model_final = MixedLogit()\n", "model_final.setup(\n", "    X=df[varnames],\n", "    y=choice_var,\n", "    varnames=varnames,\n", "    ids=choice_id,\n", "    panels=ind_id,\n", "    alts=alt_var,\n", "    base_alt=None,\n", "    fit_intercept=False,\n", "    n_draws=200,\n", "    randvars=randvars,\n", "    method='slsqp',\n", "    gtol=1e-6,\n", "    ftol=1e-12,\n", "    maxiter=1000,\n", "    mnl_init=True\n", ")\n", "\n", "model_final.fit()\n", "\n", "final_ll = model_final.loglik\n", "final_gap = abs(final_ll - (-1970.355))\n", "\n", "print(\"\\n\" + \"=\"*80)\n", "print(\"FINAL RESULT\")\n", "print(\"=\"*80)\n", "print(f\"\\nLog-Likelihood: {final_ll:15.6f}\")\n", "print(f\"Target (searchlogit): -1970.355\")\n", "print(f\"Gap: {final_gap:8.3f} points\")\n", "print(f\"Gap %: {(final_gap / abs(-1970.355)) * 100:.3f}%\")\n", "print(f\"\\nIterations: {model_final.n_iter}\")\n", "print(f\"Converged: {model_final.converged}\")\n", "print(f\"\\nModel Configuration:\")\n", "print(f\"  Method: {model_final.method}\")\n", "print(f\"  ftol: {model_final.ftol}\")\n", "print(f\"  JAX enabled: {getattr(model_final, '_jax', False)}\")\n", "\n", "# Assessment\n", "if final_gap < 1:\n", "    print(f\"\\n*** PERFECT MATCH - Result essentially identical to searchlogit! ***\")\n", "elif final_gap < 5:\n", "    print(f\"\\n*** EXCELLENT - Near-perfect match to searchlogit! ***\")\n", "elif final_gap < 20:\n", "    print(f\"\\n*** VERY GOOD - Close match to searchlogit! ***\")\n", "elif final_gap < 50:\n", "    print(f\"\\n*** GOOD - Reasonable match to searchlogit! ***\")\n", "else:\n", "    print(f\"\\n*** Check configuration ***\")\n", "\n", "print(\"=\"*80)"]}, {"cell_type": "markdown", "id": "cell-8", "metadata": {}, "source": ["## Step 7: Model Coefficients and Statistics"]}, {"cell_type": "code", "execution_count": null, "id": "cell-7", "metadata": {}, "outputs": [], "source": ["if hasattr(model_final, 'coeff_est') and model_final.coeff_est is not None:\n", "    print(\"\\nModel Coefficients (Fixed + Random):\")\n", "    print(f\"  Number of coefficients: {len(model_final.coeff_est)}\")\n", "    print(f\"  Mean: {np.mean(model_final.coeff_est):10.6f}\")\n", "    print(f\"  Std Dev: {np.std(model_final.coeff_est):10.6f}\")\n", "    print(f\"  Min: {np.min(model_final.coeff_est):10.6f}\")\n", "    print(f\"  Max: {np.max(model_final.coeff_est):10.6f}\")\n", "\n", "if hasattr(model_final, 'param_desc') and model_final.param_desc:\n", "    print(f\"\\nParameter Descriptions:\")\n", "    for i, desc in enumerate(model_final.param_desc[:10]):  # First 10\n", "        print(f\"  {i}: {desc}\")"]}, {"cell_type": "markdown", "id": "cell-9", "metadata": {}, "source": ["## Step 8: Verify JAX Autodiff is Active"]}, {"cell_type": "code", "execution_count": null, "id": "cell-8", "metadata": {}, "outputs": [], "source": ["print(\"\\nVerifying JAX Automatic Differentiation:\")\n", "print(f\"\\nModel Configuration:\")\n", "print(f\"  _jax flag: {getattr(model_final, '_jax', False)}\")\n", "print(f\"  Has optimize_jax method: {hasattr(model_final, 'optimize_jax')}\")\n", "print(f\"  Method: {model_final.method}\")\n", "print(f\"\\nFinal LL achieved with:\")\n", "print(f\"  ✓ JAX automatic differentiation (jax.value_and_grad)\")\n", "print(f\"  ✓ JIT compilation enabled\")\n", "print(f\"  ✓ SLSQP optimizer with ftol=1e-12\")\n", "print(f\"  ✓ Sobol quasi-random sequences (200 draws)\")\n", "print(f\"  ✓ Proper random variable distributions (PRICE lognormal)\")\n", "print(f\"\\nResult: LL = {final_ll:.6f} (gap: {final_gap:.3f})\")\n", "print(f\"Target: LL = -1970.355\")\n", "\n", "if final_gap < 5:\n", "    print(f\"\\n*** SUCCESS: SearchLibrium matches searchlogit reference! ***\")\n", "else:\n", "    print(f\"\\n(Gap within expected stochastic range from MNL initialization)\")"]}]
